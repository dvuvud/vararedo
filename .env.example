# AI (server-side only)
ANTHROPIC_API_KEY=

# Redis (Upstash via Vercel Marketplace). Endast e-post/token-flödet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-post
RESEND_API_KEY=
RESEND_FROM="Beredd <onboarding@resend.dev>"

# Publik bas-URL, används i länkar i mejl (lokalt: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Skyddar /api/cron/reminders (Vercel Cron skickar den som Bearer-token)
CRON_SECRET=

# Valfritt: byt modell utan kodändring (standard: claude-sonnet-5-5 / claude-haiku-4-5)
PLAN_MODEL=
FOLLOWUP_MODEL=
